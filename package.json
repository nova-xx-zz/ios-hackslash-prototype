{
  "name": "sword-crest",
  "version": "0.1.0",
  "private": true,
  "description": "ソードクレスト（Sword Crest）: 5人パーティ・オート戦闘のハクスラダンジョン",
  "scripts": {
    "test": "node --test",
    "build:www": "node tools/build-www.js",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "build:firebase": "esbuild tools/firebase-entry.js --bundle --minify --format=iife --global-name=QPFirebase --target=es2019 --legal-comments=eof --outfile=js/vendor/firebase.js",
    "build:preview:web": "node tools/build-www.js --web",
    "build:release:web": "node tools/build-www.js --web --release",
    "build:release:ios": "node tools/build-www.js --release",
    "cap:sync:release": "npm run build:release:ios && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0"
  }
}
