// Preview only: authenticated owner may back up the exact js/cloud.js envelope.
// NOTE: anonymous authentication does NOT enforce a tester allowlist.
// Do not deploy these rules for a 20-30-person invitation-only beta.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validPreviewBackup() {
      let data = request.resource.data;
      return data.keys().hasAll(['data', 'savedAt', 'schemaVersion', 'chars', 'updatedAt'])
        && data.keys().hasOnly(['data', 'savedAt', 'schemaVersion', 'chars', 'updatedAt'])
        && data.data is string
        && data.data.size() <= 921600
        && data.savedAt is int
        && data.savedAt >= 0
        && data.schemaVersion is int
        && data.schemaVersion >= 1
        && data.chars is int
        && data.chars >= 0
        && data.chars <= 921600
        && data.updatedAt == request.time;
    }
    match /saves/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create, update: if isOwner(uid) && validPreviewBackup();
    }
    // Never allow a client to read/write paid balances, purchases, roles or others' saves.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
